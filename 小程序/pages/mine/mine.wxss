/* pages/mine/mine.wxss */
.user-container {
  padding: 40rpx;
  background-color: #f5f5f5;
  height: 100vh;
  padding-top: 150rpx;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-welcome {
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
}

.user-menu {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid #eee;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #333;
}