<!--packageA/history/history.wxml-->
<!--总标题-->
<view class="intro_title">
  <van-icon  size="30px" name="arrow-left"  bindtap="goBack"/>
  <text style="font-size: 35rpx;">操作记录</text>
</view>

<view style="padding-top:20rpx;">
  <van-button plain type="primary" class="clear-btn" icon=""  size="small" bindtap="onClearLogs">
    清空全部记录
  </van-button>
</view>

<view class="log-container">
  <view wx:if="{{logs.length === 0}}" class="empty">
    暂无操作记录~
  </view>
  <block wx:for="{{logs}}" wx:key="index">
    <view class="log-item">
      <view class="log-text">{{item.text}}</view>
      <view class="log-time">{{item.time}}</view>
    </view>
  </block>
</view>